#!/usr/bin/env python3
"""Submit one /tmp/kb-* document to Fastfella's fixed-recipient broker."""

from __future__ import annotations

import argparse
import base64
import json
from pathlib import Path
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


CONFIG_PATH = Path("/home/paul/.hermes-delivery-client.env")
ALLOWED_EXTENSIONS = {
    ".csv", ".docx", ".jpg", ".jpeg", ".md", ".pdf", ".png",
    ".pptx", ".txt", ".xlsx", ".zip",
}
MAX_BYTES = 20 * 1024 * 1024


def load_config() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        for raw in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
    except OSError as exc:
        raise ValueError("delivery client configuration is unavailable") from exc
    for key in ("HERMES_DELIVERY_URL", "HERMES_DELIVERY_API_TOKEN"):
        if not values.get(key):
            raise ValueError("delivery client configuration is incomplete")
    return values


def validate_file(raw_path: str) -> Path:
    supplied = Path(raw_path)
    if supplied.is_symlink():
        raise ValueError("symbolic links are not accepted")
    path = supplied.resolve(strict=True)
    if path.parent != Path("/tmp") or not path.name.startswith("kb-"):
        raise ValueError("only regular /tmp/kb-* files may be delivered")
    if not path.is_file():
        raise ValueError("the requested attachment is not a regular file")
    if path.suffix.lower() not in ALLOWED_EXTENSIONS:
        raise ValueError("attachment type is not allowed")
    size = path.stat().st_size
    if size < 1 or size > MAX_BYTES:
        raise ValueError("attachment must be between 1 byte and 20 MiB")
    return path


def main() -> int:
    parser = argparse.ArgumentParser(description="Email a document to the fixed owner address")
    parser.add_argument("path")
    parser.add_argument("--subject", default="Document from Hermes")
    parser.add_argument("--body", default="Hermes has attached the requested document.")
    args = parser.parse_args()

    try:
        path = validate_file(args.path)
        if not 1 <= len(args.subject) <= 180 or len(args.body) > 4000:
            raise ValueError("subject or body length is outside the allowed range")
        config = load_config()
        payload = {
            "filename": path.name,
            "subject": args.subject,
            "body": args.body,
            "content_b64": base64.b64encode(path.read_bytes()).decode("ascii"),
        }
        request = Request(
            config["HERMES_DELIVERY_URL"],
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": f"Bearer {config['HERMES_DELIVERY_API_TOKEN']}",
                "Content-Type": "application/json",
            },
            method="POST",
        )
        with urlopen(request, timeout=45) as response:
            result = json.loads(response.read().decode("utf-8"))
        print(json.dumps({"ok": bool(result.get("ok")), "filename": path.name}))
        return 0 if result.get("ok") else 1
    except HTTPError as exc:
        try:
            detail = json.loads(exc.read().decode("utf-8")).get("error", "delivery rejected")
        except Exception:
            detail = "delivery rejected"
        print(json.dumps({"ok": False, "error": detail}), file=sys.stderr)
    except (OSError, URLError, ValueError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}), file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
